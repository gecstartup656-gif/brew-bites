# Replit
.cache/
.local/
# Build files
release/
# `artifacts/` contains the editable workspace packages. Ignore only their
# generated desktop output, not the application source.
artifacts/*/release/
artifacts/*/dist/
artifacts/*/desktop-tools/*
!artifacts/*/desktop-tools/pnpm.cmd

# Electron build output
dist/
out/

# Node modules
node_modules/

# Temporary files
*.tmp

# Windows files
Thumbs.db
Desktop.ini
